{
  "name": "ambassador-platform",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate",
    "db:seed": "tsx seed.ts",
    "prepare:db": "prisma generate && node ../../scripts/migrate.mjs && tsx seed.ts",
    "dev": "pnpm prepare:db && next dev --hostname 0.0.0.0 --port 3002",
    "build": "pnpm prepare:db && next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3002",
    "typecheck": "tsc --noEmit",
    "smoke": "node ../../scripts/smoke.mjs ambassador-platform"
  },
  "dependencies": {
    "@startify/shared": "workspace:*",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "6.19.3",
    "@prisma/adapter-libsql": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0"
  }
}